# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# For local machine running MongoDB locally:
MONGO_URI=mongodb://localhost:27017/taskmaster
# For Docker Compose, this is automatically overridden to:
# MONGO_URI=mongodb://mongo:27017/taskmaster

# JWT Authentication
JWT_SECRET=supersecretjwtkey_taskmaster_production_safe_token_987654321
JWT_EXPIRES_IN=7d

